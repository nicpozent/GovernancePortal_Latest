{
  "meta": {
    "name": "Birgma Governance Portal — controls-as-code catalogue",
    "description": "Single machine-readable source mapping each security/privacy control to the frameworks it satisfies, the MITRE ATT&CK techniques it mitigates, and the evidence (code/test/doc) that implements it. The deterministic report (compliance/report.mjs) computes coverage + gaps from this file. Portable JSON so it can also feed an external risk register.",
    "statusLegend": {
      "implemented": "Enforced in code/config today, with evidence.",
      "partial": "Present but not on-by-default or not complete; a residual gap remains.",
      "organizational": "A process/artifact the controller owns; the app supports it but cannot enforce it.",
      "planned": "Not yet built; a known gap."
    }
  },
  "frameworks": {
    "iso27001": {
      "name": "ISO/IEC 27001:2022 Annex A",
      "applicable": true
    },
    "nistCsf": {
      "name": "NIST CSF 2.0",
      "applicable": true
    },
    "gdpr": {
      "name": "EU GDPR",
      "applicable": true
    },
    "zeroTrust": {
      "name": "NIST SP 800-207 Zero Trust",
      "applicable": true,
      "pillars": [
        "identity",
        "device",
        "network",
        "application",
        "data",
        "visibility"
      ]
    },
    "mitre": {
      "name": "MITRE ATT&CK (Enterprise)",
      "applicable": true
    },
    "iso42001": {
      "name": "ISO/IEC 42001 (AI management system)",
      "applicable": false,
      "rationale": "The system performs no AI/ML processing (no models, inference, or AI dependencies; quiz grading is deterministic rule-based scoring). Re-assess if an AI feature is added, or if the portal is used to GOVERN other AI systems."
    },
    "euAiAct": {
      "name": "EU AI Act (Reg. 2024/1689)",
      "applicable": false,
      "rationale": "No AI system in scope, so no risk-tier obligations apply. Revisit on any AI feature."
    },
    "nistAiRmf": {
      "name": "NIST AI RMF 1.0",
      "applicable": false,
      "rationale": "No AI system in scope. Revisit on any AI feature."
    }
  },
  "risks": [
    {
      "id": "R-01",
      "title": "Unauthorized access / account takeover"
    },
    {
      "id": "R-02",
      "title": "Privilege escalation / acting beyond role"
    },
    {
      "id": "R-03",
      "title": "Tampering with compliance evidence (signatures/audit)"
    },
    {
      "id": "R-04",
      "title": "Data disclosure / confidentiality breach"
    },
    {
      "id": "R-05",
      "title": "Injection / malicious content execution"
    },
    {
      "id": "R-06",
      "title": "Data loss / unrecoverable outage"
    },
    {
      "id": "R-07",
      "title": "Supply-chain / dependency compromise"
    },
    {
      "id": "R-08",
      "title": "Undetected malicious activity"
    },
    {
      "id": "R-09",
      "title": "Privacy non-compliance (subject rights, retention)"
    },
    {
      "id": "R-10",
      "title": "Abuse / denial of service"
    }
  ],
