%% Birgma Governance Portal — Deployment / Infrastructure view
%% Physical/runtime topology: hosts, containers, ports, volumes, trust zones,
%% and the external identity/collaboration services. Complements the logical
%% container view in architecture-diagram.mmd and the data model in data-model.mmd.
%%
%% HOW TO OPEN IN LUCIDCHART: File → Import Diagram → Mermaid (paste this file).
%% Also renders on github.com, mermaid.live, VS Code, and deployment-diagram.html.

flowchart TB
    subgraph USERZONE["🌐 User zone (managed devices)"]
        BROWSER["Browser · React SPA<br/>MSAL.js (PKCE) · Entra sign-in"]
    end

    subgraph CLOUD["☁️ Microsoft cloud (external, enterprise-shared)"]
        ENTRA["Microsoft Entra ID<br/>OIDC/OAuth2 · JWKS · app roles"]
        GRAPH["Microsoft Graph<br/>users · groups · SharePoint · mail"]
    end

    subgraph VM["🖥️ Windows VM (VMware) · Docker Desktop + WSL2 — Azure-native as target"]
        subgraph DMZ["Edge (published)"]
            WEB["web container · nginx (alpine)<br/>:443 TLS 1.2/1.3 · :80→443 redirect<br/>HSTS · CSP · serves SPA · proxies /api"]
        end
        subgraph INTERNAL["Internal docker network (not published)"]
            API["api container · Node 22 / Express 5<br/>:8080 · token validation · RBAC · domain logic<br/>schedulers (leader-locked) · /metrics · /readyz"]
            DB["db container · PostgreSQL 16<br/>:5432 bound to 127.0.0.1 only<br/>least-privilege app role · append-only ledgers"]
        end
        subgraph VOLS["Docker volumes / bind mounts"]
            PGDATA[["pgdata (named volume)"]]
            UPLOADS[["./uploads (manager files)"]]
            BACKUPS[["./backups (pg_dump output)"]]
            CERTS[["./certs (TLS fullchain/privkey, ro)"]]
        end
    end

    subgraph AZURE["🎯 Azure-native target (ADR-117, planned)"]
        ACA["Container Apps (web + api)"]
        PG["Azure Database for PostgreSQL (PITR)"]
        BLOB["Azure Blob (uploads/backups)"]
        KV["Key Vault + Managed Identity"]
        PE["Private Endpoints / WAF"]
    end

    BROWSER -- "OIDC sign-in (PKCE)" --> ENTRA
    BROWSER -- "HTTPS 443 + Bearer token" --> WEB
    WEB -- "/api → http :8080 (same origin)" --> API
    API -- "SQL (internal only)" --> DB
    API -- "validate JWT (JWKS)" --> ENTRA
    API -- "app-only / Managed Identity" --> GRAPH
    DB --- PGDATA
    API --- UPLOADS
    API --- BACKUPS
    WEB --- CERTS

    AZURE -. "lift-and-shift target" .-> VM

    classDef ext fill:#e8f0fe,stroke:#0078c0,color:#0b3a5b;
    classDef web fill:#e6f3ec,stroke:#1f8a5b,color:#10402a;
    classDef api fill:#fbf2df,stroke:#caa53d,color:#5b4708;
    classDef db fill:#f6f3fd,stroke:#6d4bd1,color:#2e1d5b;
    classDef vol fill:#f3f4f8,stroke:#9aa1b2,color:#41485a;
    classDef target fill:#fff,stroke:#c0143c,stroke-dasharray:4 3,color:#7a1024;
    class BROWSER,ENTRA,GRAPH ext;
    class WEB web;
    class API api;
    class DB db;
    class PGDATA,UPLOADS,BACKUPS,CERTS vol;
    class ACA,PG,BLOB,KV,PE target;
