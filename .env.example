# Compose-level secrets — copy to `.env` (same folder as docker-compose.yml).
# These are read by docker compose for variable substitution.

# Postgres superuser password (owns the schema).
POSTGRES_PASSWORD=change_me_superuser

# Application login password. MUST match the DATABASE_URL the API uses
# (compose builds that URL from this value automatically).
APP_DB_PASSWORD=change_me_app

# ── Web app (SPA) — Entra IDs for sign-in ───────────────────
# These are PUBLIC client IDs (safe in the browser) — not secrets.
AZURE_TENANT_ID=66cdb438-f45a-45bb-9709-cfede80e5fc3
SPA_CLIENT_ID=b9f3bd3f-f945-4060-80eb-f5269c3499c4
API_CLIENT_ID=655463e2-ab20-45b2-8bd2-be9925be19dd
