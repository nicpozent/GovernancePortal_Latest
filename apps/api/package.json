{
  "name": "birgma-governance-api",
  "version": "1.0.0",
  "private": true,
  "description": "Birgma Governance Portal — backend API (Entra ID SSO, Microsoft Graph sync, SharePoint, PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:all": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'test/unit/**/*.test.js'",
    "test:coverage:gate": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=65 --test-concurrency=1 'test/**/*.test.js'",
    "lint": "eslint .",
    "diagnose": "node tools/diagnostics/diagnose.js",
    "migrate": "node db/migrate.js",
    "gdpr": "node db/gdpr.js"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.0.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
