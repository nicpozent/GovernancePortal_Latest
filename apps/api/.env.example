# ── Birgma Governance API — environment template ────────────
# Copy to `apps/api/.env` and fill in. Real .env files are gitignored.
# In production, leave the Graph credentials BLANK and use Managed Identity.

# ── Runtime ──────────────────────────────────────────────────
PORT=8080
# Allowed SPA origin for CORS (same-origin in the container; set for split hosting).
FRONTEND_ORIGIN=https://localhost
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Compose builds this from APP_DB_PASSWORD; set explicitly only for split hosting.
DATABASE_URL=postgres://governance_app:change_me_app@db:5432/governance
# Set to "require" to force TLS to Postgres (verify-full).
PGSSL=

# ── Entra ID — validates incoming user access tokens ────────
# Tenant + API app registration. These IDs are public, not secrets.
AZURE_TENANT_ID=66cdb438-f45a-45bb-9709-cfede80e5fc3
API_CLIENT_ID=655463e2-ab20-45b2-8bd2-be9925be19dd
# Defaults to api://${API_CLIENT_ID}; override only if you set a custom audience.
API_AUDIENCE=
ADMIN_APP_ROLE=Governance.Admin
MANAGER_APP_ROLE=Governance.Manager

# ── Microsoft Graph — directory sync + SharePoint reads ─────
GRAPH_ENTERPRISE_APP_SP_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIBRARY=Policies Process Procedures Guidelines
SHAREPOINT_BASE_FOLDER=Approved/Policies
# Mailbox UPN used to send reminders (needs Mail.Send application permission).
GRAPH_MAIL_SENDER=
REMINDERS_ENABLED=false

# In-process daily jobs (backup + sync/reminders). Set to false on all but one
# replica when running more than one API instance (they are not multi-instance safe).
SCHEDULERS_ENABLED=true

# ── Graph credentials — LOCAL DEV ONLY ──────────────────────
# Leave BLANK in production: DefaultAzureCredential uses the Managed Identity,
# so no secret is ever stored on disk. Set both only for local development.
GRAPH_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Optional: SCIM provisioning endpoint (scim/scim.routes.js) ──
# A long random bearer token Entra presents when pushing users. Store in Key Vault.
SCIM_SECRET_TOKEN=

# ── Uploaded-file storage (manager trainings/documents) ─────
# Where multer stages the incoming upload before it is finalized.
UPLOAD_DIR=/uploads
# 'local' (default) keeps files on the /uploads volume — unchanged single-host
# behaviour. Set 'blob' to store them in Azure Blob so ANY API replica can serve
# them (required before scaling the API to more than one instance / HA).
STORAGE_DRIVER=local
# Blob driver only. Prefer Managed Identity via the account URL in production
# (no secret on disk); use a connection string for local development.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
